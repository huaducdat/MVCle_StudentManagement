@model IEnumerable<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<h2 class="mb-4">Danh sách sinh viên</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">
    + Thêm sinh viên
</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentId</td>
                <td>@student.StudentCode</td>
                <td>@student.FullName</td>
                <td>
                    @student.DateOfBirth?.ToString("dd/MM/yyyy")
                </td>
                <td>@student.Email</td>
                <td>@student.Phone</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@student.StudentId"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.StudentId"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">
        Chưa có sinh viên nào.
    </p>
}
